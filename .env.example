# Google API credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Hunter.io API key (free tier: 50 verifications/month)
HUNTER_API_KEY=your_hunter_api_key_here

# Gmail send-from address
SEND_FROM_EMAIL=admin@tradetracktemplate.com

# Daily email send limit
DAILY_SEND_LIMIT=30

# Flask secret key
FLASK_SECRET_KEY=change-this-to-a-random-string

# Google Sheet name
SHEET_NAME=TradeTrack Outreach
